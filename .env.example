FLASK_ENV=development
PYTHONPATH=src
PROJECT_NAME="Oracle Notification Dispatch Lab"

# Oracle AI Database 26ai Free local lab placeholders.
# Copy this file to .env and replace password placeholders locally before
# starting Docker or running managed install scripts.
ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
ORACLE_PWD=change_me_in_local_env
ORACLE_HOST_PORT=1521
ORACLE_PDB=FREEPDB1
BACKUP_ROOT=backups/oracle-notification-dispatch-lab

# Local-only lab user password placeholders used by scripts/install-db.sh.
AI_APP_OWNER_PWD=change_me_in_local_env
AI_APP_RUNTIME_PWD=change_me_in_local_env
AI_APP_READONLY_PWD=change_me_in_local_env
AI_REVIEWER_PWD=change_me_in_local_env
